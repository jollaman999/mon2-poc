# 복사해서 inventory.env 로 쓴다. inventory.env 는 커밋하지 않는다.
JUMP=root@jump.example.com          # 노드로 들어가는 점프 호스트 (없으면 비운다)
SSH_KEY=/path/to/key.pem             # 노드 접속 키
SSH_USER=rocky                       # sudo 가 되는 계정
NODE_A=192.0.2.11                    # 중앙 노드 A
NODE_B=192.0.2.12                    # 중앙 노드 B. 비우면 단일 노드로 설치
RETENTION=30d                        # 저장소 보관 기간
QUEUE_MAX=10GB                       # 중계 목적지별 디스크 큐 한도 (PoC 실측 전 임시값)
TLS_VERIFY=skip                      # 상대 노드 HTTPS 인증서: skip(검증 안 함) 또는 ca(사설 CA 로 검증)

# 이름 · 경로 · 계정 (비우면 기본값)
NAME=cmp-mon                         # 컨테이너 이름 앞말(cmp-mon-vmagent 등)과 기본 디렉터리 이름
SERVICE_USER=                        # 컨테이너 안 실행 계정(uid · gid). 기본 NAME. 이미 있는 계정이면 만들지 않고 그대로 쓴다
BASE_DIR=                            # 기본 /NAME. 아래에 compose · conf · data · logs 를 둔다
