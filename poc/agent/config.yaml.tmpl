# cmp-otelcol 설정 틀. install.sh(Linux) · windows/install.ps1 이 @...@ 를 채워 conf/config.yaml 로 쓴다.
extensions:
  file_storage:
    directory: "@QUEUE_DIR@"
    create_directory: true

receivers:
  hostmetrics:
    collection_interval: @INTERVAL@
    scrapers:
      cpu: {}
      memory: {}
      load: {}
  otlp:
    protocols:
      http:
        endpoint: 127.0.0.1:14318

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 256
  resourcedetection:
    detectors: [system]
    system:
      hostname_sources: [os]
  batch:
    timeout: 1s

exporters:
  cmpotlp:
    endpoints: [@ENDPOINTS@]
    start_key: "@START_KEY@"           # 비우면 호스트 이름
    failback_interval: @FAILBACK@
    timeout: 5s
    tls:
      @TLS@                            # TLS_VERIFY=skip 이면 검증 안 함, ca 면 사설 CA 로 검증
    sending_queue:
      storage: file_storage
    retry_on_failure:
      enabled: true
      max_elapsed_time: 0               # 큐에 있는 동안 계속 재시도

service:
  extensions: [file_storage]
  telemetry:
    logs:
      level: info
      output_paths: ["@LOG_FILE@"]
      error_output_paths: ["@LOG_FILE@"]
  pipelines:
    metrics:
      receivers: [hostmetrics, otlp]
      processors: [memory_limiter, resourcedetection, batch]
      exporters: [cmpotlp]
    logs:
      receivers: [otlp]
      processors: [memory_limiter, resourcedetection, batch]
      exporters: [cmpotlp]
    traces:
      receivers: [otlp]
      processors: [memory_limiter, resourcedetection, batch]
      exporters: [cmpotlp]
