# @SELF@ = 이 노드, @PEER@ = 상대 노드. install.sh 가 바꿔 넣는다.
#
# 바깥에 여는 포트는 셋이다 (Alertmanager 클러스터 9094 는 HAProxy 밖).
#   4318  수집   에이전트 · 앱 · 기존 Prometheus
#   8443  조회   관리 서버 · vmalert
#   7443  노드 사이   상대 노드만
# 부품은 모두 127.0.0.1 에서만 듣는다.
#
# 원칙: 로컬 부품을 먼저 쓰고, 로컬이 죽었으면 상대 노드의 7443 으로 보낸다.
# HAProxy 는 서버별로 경로를 바꿀 수 없어서, 로컬 · 상대를 백엔드로 나누고
# nbsrv(살아 있는 서버 수)로 고른다.

global
    log /dev/log local0
    maxconn 20000

defaults
    mode http
    log global
    option httplog
    timeout connect 3s
    timeout client 60s
    timeout server 60s
    default-server inter 2s fall 2 rise 2

frontend stats
    bind 127.0.0.1:8404
    stats enable
    stats uri /stats
    monitor-uri /healthz

# ======================================================== 수집 :4318
frontend ingest
    bind @SELF@:4318
    acl is_metrics path_beg /v1/metrics
    acl is_logs    path_beg /v1/logs
    acl is_traces  path_beg /v1/traces
    acl is_rw      path_beg /api/v1/write
    acl vm_up nbsrv(ing_vm_local) gt 0
    acl vl_up nbsrv(ing_vl_local) gt 0
    acl vt_up nbsrv(ing_vt_local) gt 0
    use_backend ing_vm_local if is_metrics vm_up
    use_backend ing_vm_peer  if is_metrics
    use_backend ing_rw_local if is_rw vm_up
    use_backend ing_rw_peer  if is_rw
    use_backend ing_vl_local if is_logs vl_up
    use_backend ing_vl_peer  if is_logs
    use_backend ing_vt_local if is_traces vt_up
    use_backend ing_vt_peer  if is_traces

backend ing_vm_local
    option httpchk GET /health
    http-request set-path /opentelemetry/v1/metrics
    server local 127.0.0.1:8429 check
backend ing_vm_peer
    option httpchk GET /vmagent/health
    http-request set-path /vmagent/opentelemetry/v1/metrics
    server peer @PEER@:7443 check
backend ing_rw_local
    option httpchk GET /health
    server local 127.0.0.1:8429 check
backend ing_rw_peer
    option httpchk GET /vmagent/health
    http-request set-path /vmagent%[path]
    server peer @PEER@:7443 check
backend ing_vl_local
    option httpchk GET /health
    http-request set-path /insert/opentelemetry/v1/logs
    server local 127.0.0.1:9429 check
backend ing_vl_peer
    option httpchk GET /vlagent/health
    http-request set-path /vlagent/insert/opentelemetry/v1/logs
    server peer @PEER@:7443 check
backend ing_vt_local
    option httpchk GET /health
    http-request set-path /insert/opentelemetry/v1/traces
    server local 127.0.0.1:10429 check
backend ing_vt_peer
    option httpchk GET /vtagent/health
    http-request set-path /vtagent/insert/opentelemetry/v1/traces
    server peer @PEER@:7443 check

# ======================================================== 조회 :8443
# /metrics/... → VictoriaMetrics, /logs/... → VictoriaLogs, /traces/... → VictoriaTraces
# vmalert 는 데이터소스를 /metrics 하나로 쓰므로 /metrics/select/logsql/... 은 VictoriaLogs 로 보낸다.
frontend query
    bind @SELF@:8443
    acl to_vl path_beg /logs/ /metrics/select/logsql/
    acl to_vt path_beg /traces/
    acl to_vm path_beg /metrics/
    http-request set-var(txn.dst) str(vl) if to_vl
    http-request set-var(txn.dst) str(vt) if !to_vl to_vt
    http-request set-var(txn.dst) str(vm) if !to_vl !to_vt to_vm
    http-request deny deny_status 404 unless { var(txn.dst) -m found }
    http-request set-path %[path,regsub(^/metrics/,/)] if { path_beg /metrics/ }
    http-request set-path %[path,regsub(^/logs/,/)]    if { path_beg /logs/ }
    http-request set-path %[path,regsub(^/traces/,/)]  if { path_beg /traces/ }
    acl vm_up nbsrv(q_vm_local) gt 0
    acl vl_up nbsrv(q_vl_local) gt 0
    acl vt_up nbsrv(q_vt_local) gt 0
    use_backend q_vm_local if { var(txn.dst) -m str vm } vm_up
    use_backend q_vm_peer  if { var(txn.dst) -m str vm }
    use_backend q_vl_local if { var(txn.dst) -m str vl } vl_up
    use_backend q_vl_peer  if { var(txn.dst) -m str vl }
    use_backend q_vt_local if { var(txn.dst) -m str vt } vt_up
    use_backend q_vt_peer  if { var(txn.dst) -m str vt }

backend q_vm_local
    option httpchk GET /health
    server local 127.0.0.1:8428 check
backend q_vm_peer
    option httpchk GET /vm/health
    http-request set-path /vm%[path]
    server peer @PEER@:7443 check
backend q_vl_local
    option httpchk GET /health
    server local 127.0.0.1:9428 check
backend q_vl_peer
    option httpchk GET /vl/health
    http-request set-path /vl%[path]
    server peer @PEER@:7443 check
backend q_vt_local
    option httpchk GET /health
    server local 127.0.0.1:10428 check
backend q_vt_peer
    option httpchk GET /vt/health
    http-request set-path /vt%[path]
    server peer @PEER@:7443 check

# ======================================================== 노드 사이 :7443
# 상대 노드(와 자기 자신)만 받는다. 첫 경로 조각으로 부품을 고르고 떼어 낸 뒤 넘긴다.
frontend peer
    bind @SELF@:7443
    http-request deny deny_status 403 unless { src @PEER@ @SELF@ 127.0.0.1 }
    http-request set-var(txn.part) path,field(2,/)
    http-request set-path %[path,regsub(^/[a-z]+/,/)]
    use_backend p_vm      if { var(txn.part) -m str vm }
    use_backend p_vl      if { var(txn.part) -m str vl }
    use_backend p_vt      if { var(txn.part) -m str vt }
    use_backend p_vmagent if { var(txn.part) -m str vmagent }
    use_backend p_vlagent if { var(txn.part) -m str vlagent }
    use_backend p_vtagent if { var(txn.part) -m str vtagent }
    use_backend p_am      if { var(txn.part) -m str am }
    default_backend p_none

backend p_none
    http-request deny deny_status 404

backend p_vm
    server local 127.0.0.1:8428
backend p_vl
    server local 127.0.0.1:9428
backend p_vt
    server local 127.0.0.1:10428
backend p_vmagent
    server local 127.0.0.1:8429
backend p_vlagent
    server local 127.0.0.1:9429
backend p_vtagent
    server local 127.0.0.1:10429
backend p_am
    server local 127.0.0.1:9093
