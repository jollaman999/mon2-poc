[Unit]
Description=Alertmanager (알림 중복 제거, 클러스터)
After=network-online.target
Wants=network-online.target

[Service]
User=mon2
Group=mon2
EnvironmentFile=/etc/mon2/mon2.env
ExecStart=/opt/mon2/bin/alertmanager --config.file=/etc/mon2/alertmanager.yml --storage.path=/var/lib/mon2/alertmanager --web.listen-address=127.0.0.1:9093 --cluster.listen-address=${SELF}:9094 --cluster.peer=${PEER}:9094
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
