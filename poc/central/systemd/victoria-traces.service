[Unit]
Description=VictoriaTraces (트레이스 저장)
After=network-online.target
Wants=network-online.target

[Service]
User=mon2
Group=mon2
EnvironmentFile=/etc/mon2/mon2.env
ExecStart=/opt/mon2/bin/victoria-traces-prod -httpListenAddr=127.0.0.1:10428 -storageDataPath=/var/lib/mon2/victoria-traces -retentionPeriod=${RETENTION}
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
