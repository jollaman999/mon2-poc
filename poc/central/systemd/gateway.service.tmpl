[Unit]
Description=@NAME@ 입구 vmauth (수집 4318 · 조회 8443 · 노드 사이 7443, HTTPS)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
Group=@GROUP@
EnvironmentFile=@CONF@/env
# 바깥 포트는 프록시만 받고, vmauth 자체 지표 · 재적재 주소는 127.0.0.1:8427 로 뺀다
# GW_ARGS: 듣는 주소 · TLS 인증서 · 상대 노드 인증서 검증 방식 (install.sh 가 env 에 쓴다)
ExecStart=@BIN@/vmauth-prod -auth.config=@CONF@/gateway.yml -httpInternalListenAddr=127.0.0.1:8427 -loadBalancingPolicy=first_available $GW_ARGS
Restart=always
RestartSec=3
LimitNOFILE=1048576
StandardOutput=append:@LOGS@/gateway.log
StandardError=append:@LOGS@/gateway.log

[Install]
WantedBy=multi-user.target
