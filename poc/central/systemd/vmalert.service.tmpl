[Unit]
Description=@NAME@ vmalert (알림 규칙 평가)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
Group=@GROUP@
EnvironmentFile=@CONF@/env
ExecStart=@BIN@/vmalert-prod -httpListenAddr=127.0.0.1:8880 -datasource.url=https://${SELF}:8443/metrics -datasource.bearerTokenFile=@CONF@/tokens/query.token -remoteRead.url=https://${SELF}:8443/metrics -remoteRead.bearerTokenFile=@CONF@/tokens/query.token -remoteWrite.url=https://${SELF}:4318 -notifier.url=http://127.0.0.1:9093 $VMALERT_PEER_ARGS $VMALERT_TLS_ARGS -rule=@CONF@/rules/*.yml
Restart=always
RestartSec=3
LimitNOFILE=1048576

StandardOutput=append:@LOGS@/vmalert.log
StandardError=append:@LOGS@/vmalert.log

[Install]
WantedBy=multi-user.target
