[Unit]
Description=VictoriaLogs (로그 저장)
After=network-online.target
Wants=network-online.target

[Service]
User=mon2
Group=mon2
EnvironmentFile=/etc/mon2/mon2.env
ExecStart=/opt/mon2/bin/victoria-logs-prod -httpListenAddr=${SELF}:9428 -storageDataPath=/var/lib/mon2/victoria-logs -retentionPeriod=${RETENTION}
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
