[Unit]
Description=@NAME@ VictoriaMetrics (메트릭 저장)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
Group=@GROUP@
EnvironmentFile=@CONF@/env
ExecStart=@BIN@/victoria-metrics-prod -httpListenAddr=127.0.0.1:8428 -storageDataPath=@DATA@/victoria-metrics -retentionPeriod=${RETENTION} -dedup.minScrapeInterval=1ms -opentelemetry.usePrometheusNaming
Restart=always
RestartSec=3
LimitNOFILE=1048576

StandardOutput=append:@LOGS@/victoria-metrics.log
StandardError=append:@LOGS@/victoria-metrics.log

[Install]
WantedBy=multi-user.target
