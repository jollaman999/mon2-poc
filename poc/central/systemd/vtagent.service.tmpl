[Unit]
Description=@NAME@ vtagent (트레이스 중계, 양쪽 저장소에 복제)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
Group=@GROUP@
EnvironmentFile=@CONF@/env
ExecStart=@BIN@/vtagent-prod -httpListenAddr=127.0.0.1:10429 -remoteWrite.url=http://127.0.0.1:10428/insert/native $VT_PEER_ARGS -remoteWrite.tmpDataPath=@DATA@/vtagent-queue -remoteWrite.maxDiskUsagePerURL=${QUEUE_MAX}
Restart=always
RestartSec=3
LimitNOFILE=1048576

StandardOutput=append:@LOGS@/vtagent.log
StandardError=append:@LOGS@/vtagent.log

[Install]
WantedBy=multi-user.target
