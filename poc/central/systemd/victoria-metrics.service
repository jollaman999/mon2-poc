[Unit]
Description=VictoriaMetrics (메트릭 저장)
After=network-online.target
Wants=network-online.target

[Service]
User=mon2
Group=mon2
EnvironmentFile=/etc/mon2/mon2.env
ExecStart=/opt/mon2/bin/victoria-metrics-prod -httpListenAddr=${SELF}:8428 -storageDataPath=/var/lib/mon2/victoria-metrics -retentionPeriod=${RETENTION} -dedup.minScrapeInterval=1ms -opentelemetry.usePrometheusNaming
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
