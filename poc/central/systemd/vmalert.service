[Unit]
Description=vmalert (알림 규칙 평가)
After=network-online.target
Wants=network-online.target

[Service]
User=mon2
Group=mon2
EnvironmentFile=/etc/mon2/mon2.env
ExecStart=/opt/mon2/bin/vmalert-prod -httpListenAddr=127.0.0.1:8880 -datasource.url=http://${SELF}:8443/metrics -remoteWrite.url=http://${SELF}:4318 -remoteRead.url=http://${SELF}:8443/metrics -notifier.url=http://127.0.0.1:9093 -notifier.url=http://${PEER}:7443/am -rule=/etc/mon2/rules/*.yml
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
